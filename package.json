{
  "name": "ct-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "cf:dev": "XDG_CONFIG_HOME=/tmp/ct-website-config WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 8790",
    "test": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
