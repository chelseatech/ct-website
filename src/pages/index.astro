---
import Base from '../layouts/Base.astro';
import services from '../data/services.json';
---
<Base title="Technology that feels human" description="Websites, useful tools and prototypes from a Canadian technology team.">
<section class="hero wrap"><div><p class="eyebrow">A little clarity goes a long way</p><h1>Good tech.<br/>More <em>human.</em></h1><p class="intro">Websites, useful tools and first versions that make room for good ideas.</p><div class="actions"><a class="button" href="/services/">Explore our services <span aria-hidden="true">→</span></a><a class="text-link" href="/about/#contact">Let’s connect <span aria-hidden="true">→</span></a></div><p class="audience">Curious minds. Canadian roots.</p></div><div class="visual"><div class="visual-label"><span class="status-dot"></span> Making the complex feel simple</div><img src="/connections.svg" alt="A website, workflows and people connected through a shared system." width="640" height="560"/></div></section>
<section class="service-section wrap"><div class="section-heading"><div><p class="eyebrow">What we do</p><h2>Bring it all together.</h2></div><a class="text-link" href="/services/">See all services →</a></div><div class="cards">{services.slice(0,3).map((service,i)=><article><span class="number">0{i+1}</span><h3>{service.title}</h3><p>{service.description}</p></article>)}</div></section>
<section class="callout wrap"><p class="eyebrow">Clarity, connection, confidence</p><h2>Your work is the focus.<br/>Technology should help.</h2><a class="button light" href="/about/">Get to know Chelsea Tech →</a></section>
</Base>
